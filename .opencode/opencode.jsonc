{
  "$schema": "https://opencode.ai/config.json",
  // ---------------------------------------------------------------------------
  // Project-level opencode config for poetry-platform-monorepo.
  // Duplicated from global config for team sharing — each evolves independently.
  // All files in .opencode/ and prompts/ are version-controlled for team sharing.
  // ---------------------------------------------------------------------------

  // Auto-load architecture.md into every session's system context.
  "instructions": [
    "architecture.md"
  ],

  // Start every session in build agent mode.
  "default_agent": "build",

  // Prevent context overflow during long sessions.
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },

  // Global permission baseline — the project overrides for team consistency.
  "permission": {
    "edit": "allow",
    "bash": {
      "git push": "ask",
      "rm -rf *": "ask",
      "*": "allow"
    }
  },

  // LSP enables type-aware diagnostics for the AI.
  "lsp": true,

  // ---------------------------------------------------------------------------
  // Agent Definitions
  // ---------------------------------------------------------------------------
  "agent": {
    // --- Primary: Fast, pragmatic coder ---
    "build": {
      "description": "Blazing fast routine coding, autocompletion, and boilerplate. Zero talking, maximum execution.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-flash",
      "temperature": 0.1,
      "color": "accent",
      "prompt": "You are a pragmatist. Write clean, self-documenting code with inline native comments (JSDoc/Docstrings) explaining the 'WHY'. No conversational filler. If the user mentions tests, invoke the 'tdd-craftsman' skill immediately via your skill tool.",
      "permission": {
        "task": {
          // Verified 2026-07-13: oracle and openspec-plan are present
          "oracle": "allow",
          "openspec-plan": "allow",
          "code-executor": "allow",
          "gigabuild": "allow",
          "gigaplan": "allow"
        }
      }
    },
    // --- Primary: Read-only codebase navigation and design review ---
    "plan": {
      "description": "Fast read-only codebase navigation and logic explanations.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-flash",
      "temperature": 0.1,
      "color": "info",
      "permission": {
        "edit": "deny",
        "task": {
          "*": "deny",
          "gigaplan": "allow"
        }
      },
      "prompt": "You are a technical mentor. Explain code fragments cleanly to help the user grow. You are strictly read-only."
    },
    // Disable built-in OpenCode subagents (we use OMO Slim managed ones)
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    // Council subagents — read-only
    "council": {
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny"
        }
      }
    },
    "councillor": {
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny"
        }
      }
    },
    // Analyzer can dispatch council
    "analyzer": {
      "permission": {
        "task": {
          "council": "allow"
        }
      }
    }
  },

  // ---------------------------------------------------------------------------
  // Provider Definitions — models available for all agents
  // ---------------------------------------------------------------------------
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen2.5-coder:14b": {
          "name": "Qwen 2.5 Coder 14B (FAST)",
          "roles": [
            "chat",
            "edit",
            "apply"
          ]
        },
        "qwen3-coder:30b": {
          "name": "Qwen 3 Coder 30B (Heavy reasoning)",
          "roles": [
            "chat",
            "edit",
            "apply"
          ]
        },
        "gemma3:12b": {
          "name": "Gemma 3 12B (Lightweight — RAG / theory)",
          "roles": [
            "chat",
            "edit",
            "apply"
          ]
        }
      }
    },
    "github-models": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GitHub Models (Copilot Pro)",
      "options": {
        "baseURL": "https://models.inference.ai.azure.com",
        "apiKey": "{env:GITHUB_TOKEN}"
      },
      "models": {
        "gpt-4o-mini": {
          "name": "GPT-4o Mini — fast pragmatic work",
          "roles": [
            "chat",
            "edit",
            "apply"
          ]
        },
        "gemini-2.5-pro-001-05": {
          "name": "Gemini 2.5 Pro — Google's strongest reasoning",
          "roles": [
            "chat",
            "edit"
          ]
        },
        "gemini-3.0-flash-001": {
          "name": "Gemini 3.0 Flash — Google's latest fast model",
          "roles": [
            "chat",
            "edit",
            "apply"
          ]
        }
      }
    }
  },

  // ---------------------------------------------------------------------------
  // References — Memory Shelf location
  // ---------------------------------------------------------------------------
  "references": {
    "shelf": {
      "path": ".opencode",
      "description": "Memory Shelf, agent config, and opencode project settings. Read .opencode/memory-shelf.yaml first — it's the central index of all RAG knowledge bases, research conspects, specs, and analyses."
    }
  },

  // ---------------------------------------------------------------------------
  // Plugins — loaded by OpenCode for this project
  // ---------------------------------------------------------------------------
  "plugin": [
    "envsitter-guard",
    "opencode-subagent-output",
    "opencode-snip",
    "opencode-dynamic-context-pruning",
    "opencode-telemetry",
    "oh-my-opencode-slim"
  ],

  // ---------------------------------------------------------------------------
  // MCP Servers — live external tool access
  // ---------------------------------------------------------------------------
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "description": "Search library documentation (Node.js, Python, NumPy, etc.)"
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "description": "Search GitHub for reference code patterns"
    },
    "console-ninja": {
      "type": "local",
      "command": [
        "node",
        "C:\\Users\\qualt\\.console-ninja\\mcp\\"
      ]
    }
  },

  // ---------------------------------------------------------------------------
  // Custom Commands — reusable multi-step workflows via Ctrl+K
  // ---------------------------------------------------------------------------
  "command": {
    "tdd-cycle": {
      "template": "Execute a full TDD cycle for $ARGUMENTS:\n1. Invoke 'feature-interviewer' skill to gather specifications\n2. RED: write failing test (invoke 'test-architect' skill)\n3. GREEN: implement minimum code to pass\n4. REFACTOR: optimize for hot-path performance + clarity\n5. Run verification gates: vitest run && tsc --noEmit && eslint .",
      "description": "Full feature TDD cycle with pre-build interview (e.g. /tdd-cycle implement stress detection for Ukrainian)",
      "agent": "build"
    },
    "test-package": {
      "template": "Run the full test suite for @poetry/$ARGUMENTS with vitest run --reporter=verbose. If any tests fail, analyze the errors and suggest fixes.",
      "description": "Run tests with verbose output for a specific package (e.g. /test-package editor-engine)",
      "agent": "build"
    },
    "arch-check": {
      "template": "Review the architecture of the code at $ARGUMENTS against architecture.md and SOLID principles. Check for: single responsibility violations, missing DI, state mutation outside Orchestrator, worker boundary leaks, OCC version check omissions. Report any violations with specific line references.",
      "description": "Audit code against architectural standards (e.g. /arch-check packages/editor-engine/src)",
      "agent": "plan"
    },
    "code-ownership": {
      "template": "Analyze the code at $ARGUMENTS for maintainability and ownership:\n1. Are public APIs documented with JSDoc explaining WHY?\n2. Are modules single-responsibility?\n3. Is there dead code or speculative generality?\n4. Are tests present and meaningful?\n5. Are there architectural pattern violations?\nProduce a maintainability score (1-10) and specific improvement recommendations.",
      "description": "Evaluate code ownership quality and maintainability (e.g. /code-ownership packages/phonetics-core)",
      "agent": "plan"
    }
  }
}
