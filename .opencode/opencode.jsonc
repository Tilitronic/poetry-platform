{
  "$schema": "https://opencode.ai/config.json",

  // ---------------------------------------------------------------------------
  // Project-level opencode config for poetry-platform-monorepo.
  // Duplicated from global config for team sharing — each evolves independently.
  // All files in .opencode/ and prompts/ are version-controlled for team sharing.
  // ---------------------------------------------------------------------------

  // Instructions loaded via orchestrator_append.md — no global spam.

  "instructions": [],

  // Start every session in orchestrator agent mode (OMO Slim orchestrator).
  "default_agent": "orchestrator",

  // Prevent context overflow during long sessions.
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 16000
  },

  // Global permission baseline — the project overrides for team consistency.
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",

      "sudo *": "deny",

      "git remote set-url *": "deny",
      "git remote add *": "deny",
      "git remote remove *": "deny",
      "git remote prune *": "deny",
      "git remote rename *": "deny",

      "git reset --hard *": "deny",
      "git reset --hard": "deny",
      "git clean -fdx *": "deny",
      "git clean -fdx": "deny",
      "git clean -fd *": "deny",
      "git clean -fd": "deny",
      "git clean -f *": "deny",
      "git clean -f": "deny",
      "git checkout -- .": "deny",
      "git restore .": "deny",
      "git restore --staged .": "deny",
      "git branch -D *": "deny",
      "git filter-branch *": "deny",
      "git filter-repo *": "deny",
      "git tag -d *": "deny",

      "git push --force-with-lease *": "deny",
      "git push --force-with-lease": "deny",
      "git push --force *": "deny",
      "git push --force": "deny",
      "git push -f *": "deny",
      "git push -f": "deny",
      "git push * --force-with-lease *": "deny",
      "git push * --force-with-lease": "deny",
      "git push * --force *": "deny",
      "git push * --force": "deny",
      "git push * -f *": "deny",
      "git push * -f": "deny",

      "git push origin main": "deny",
      "git push origin main:*": "deny",
      "git push * origin main": "deny",
      "git push * origin main:*": "deny",
      "git push origin HEAD:main": "deny",
      "git push * HEAD:main": "deny",
      "git push --all *": "deny",
      "git push --all": "deny",
      "git push --mirror *": "deny",
      "git push --mirror": "deny",
      "git push origin +*:main": "deny",
      "git push * +*:main": "deny",
      "git push origin :main": "deny",
      "git push * :main": "deny",

      "git push --delete *": "deny",
      "git push --delete": "deny",
      "git push origin --delete *": "deny",
      "git push * --delete *": "deny",

      "rm -rf *": "ask",
      "rm *": "ask",
      "rmdir *": "ask",
      "chmod *": "ask",
      "chown *": "ask"
    }
  },

  // LSP enables type-aware diagnostics for the AI.
  "lsp": true,

  // ---------------------------------------------------------------------------
  // Agent Definitions
  // ---------------------------------------------------------------------------
  "agent": {
    // Disable built-in OpenCode subagents (we use OMO Slim managed ones)
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    // Agent modes/colors + permissions (merged from the old opencode.json)
    // The orchestrator is the plugin's real delegating agent (oh-my-opencode-slim@2.2.8
    // registers it as `orchestrator`). It must NEVER perform engineering work itself:
    // bash/apply_patch/ast_grep_replace/webfetch/envsitter are denied so delegation
    // is mechanically enforced. DIA-036 + DIA-060: read is path-scoped to the session dir
    // + boot/rules files + ticket ledger (the orchestrator knows NOTHING about the
    // codebase except what delegation results report); edit is path-scoped to
    // .opencode/session/*
    // (covers write+apply_patch per OpenCode docs — flat `write` key removed).
    "orchestrator": {
      "color": "#6366F1",
      "permission": {
        "bash": "deny",
        "apply_patch": "deny",
        "ast_grep_replace": "deny",
        "webfetch": "deny",
        "envsitter_set": "deny",
        "envsitter_add": "deny",
        "envsitter_delete": "deny",
        "envsitter_unset": "deny",
        "envsitter_annotate": "deny",
        "envsitter_format": "deny",
        "envsitter_reorder": "deny",
        "envsitter_copy": "deny",
        "read": {
          "*": "deny",
          ".opencode/session/*": "allow",
          "docs/dev-infra-audit/NEXT-RUN.md": "allow",
          "docs/dev-infra-audit/tickets/*": "allow",
          "docs/dev-infra-audit/tickets/archive/*": "allow",
          ".opencode/practice-protected.md": "allow",
          "AGENTS.md": "allow"
        },
        "edit": {
          "*": "deny",
          ".opencode/session/*": "allow"
        },
        "glob": {
          "*": "deny",
          ".opencode/session/*": "allow",
          "docs/dev-infra-audit/tickets/*": "allow",
          "docs/dev-infra-audit/tickets/archive/*": "allow"
        },
        "grep": "deny",
        "task": {
          "*": "deny",
          "coder": "allow",
          "architector": "allow",
          "analyzer": "allow",
          "reviewer": "allow",
          "designer": "allow",
          "code-navigator": "allow",
          "researcher": "allow",
          "observer": "allow",
          "memory-manager": "allow",
          "resource-manager": "allow",
          "ai-specialist": "allow",
          "ai-auditor": "allow",
          "conspecter": "allow",
          "openspec-plan": "allow",
          "council": "allow",
          "councillor": "allow",
          "councillor-claude-sonnet-4.5": "allow",
          "councillor-deepseek": "allow",
          "councillor-gemini-3.1-pro": "allow",
          "councillor-gpt-5.3-codex": "allow",
          "councillor-qwen3.7-plus": "allow"
        },
        "cancel_task": "allow",
        "log_decision": "allow",
        "list": "allow",
        "lsp": "allow",
        "question": "allow",
        "wait_for_user": "allow",
        "todowrite": "allow",
        "skill": "allow",
        "websearch": "deny"
      }
    },
    "architector": {
      "color": "#8B5CF6",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "analyzer": {
      "mode": "subagent",
      "color": "#14B8A6",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "reviewer": {
      "color": "#F59E0B",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    // coder deliberately has minimal permission restrictions (unlike architector/analyzer/
    // reviewer). It is the implementer: it must edit files, run bash (dev build, lint,
    // tests) and dispatch subagents. Denying any of these breaks its core function.
    // Two restrictions (DIA-078, 2026-08-10): "doom_loop": "deny" is a mechanical halt on
    // 3x-identical calls to break the snip-prefix repeat loop; bash snip deny (DIA-078,
    // ai--1 §10 gate) forbids the snip wrapper entirely — it is a display-trimming TUI
    // helper with zero legitimate agent use (fork/exec + SyntaxError breaks workflows).
    // M2 decision (2026-08-01): document intent instead of restricting.
    // DORMANT post-snip-removal (2026-08-11): rules kept as zero-cost hallucination guardrail per council 5/5; plugin opencode-snip@1.6.1 removed from global plugin array - do NOT remove these rules.
    "coder": {
      "mode": "subagent",
      "color": "#3B82F6",
      "permission": {
        "doom_loop": "deny",
        "bash": {
          "snip": "deny",
          "snip *": "deny"
        }
      }
    },
    "code-navigator": {
      "mode": "subagent",
      "color": "#06B6D4"
    },
    "researcher": {
      "mode": "subagent",
      "color": "#84CC16",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "designer": {
      "mode": "subagent",
      "color": "#EC4899"
    },
    "observer": {
      "mode": "subagent",
      "color": "#A855F7"
    },
    "memory-manager": {
      "mode": "subagent",
      "color": "#F472B6"
    },
    // Council subagents — read-only
    "council": {
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny"
        }
      }
    },
    // resource-manager — knowledge-source curation lane (DIA-007 split).
    // Artifact-producer tier (practice-protected.md §5): edit scoped to the OMO
    // knowledge/ dir ONLY; bash limited to curl/wget/trafilatura for Tier-1
    // Markdown caching + Tier-2 re-fetch. May dispatch @researcher/@conspecter
    // (task: allow) to gather curation evidence (star counts, pricing, terms).
    "resource-manager": {
      "description": "Curates ai-assist-sources.yaml and Tier-1 knowledge caches (Markdown), re-fetches Tier-2 volatile sources, and evaluates awesome-opencode tools by star count (<100 experimental, 100-500 reasonable, 500+ established). Artifact-producer — edit scoped to knowledge/ only.",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "color": "#0891B2",
      "permission": {
        "edit": {
          "*": "deny",
          ".opencode/oh-my-opencode-slim/knowledge/*": "allow"
        },
        "bash": {
          "curl": "allow",
          "wget": "allow",
          "trafilatura": "allow",
          "*": "deny"
        },
        "task": "allow"
      }
    },
    "ai-specialist": {
      "description": "Read-only researcher of agent/skill/config best practices for OpenCode itself. Findings routed through orchestrator for persistence. Scope: documentation + config review only; no runtime dispatch authority; no implementation.",
      "mode": "subagent",
      "model": "opencode-go/qwen3.7-plus",
      "temperature": 0.3,
      "color": "info",
      "permission": {
        "edit": "deny",
        "bash": {
          "curl": "allow",
          "wget": "allow",
          "*": "deny"
        },
        "task": "deny"
      }
    },
    // ai-auditor — independent read-only reviewer for §10 config changes
    // (DIA-053). Pure-analyst tier: findings routed via orchestrator for
    // persistence. Orchestrator brief SUPERSEDES design.md §2: bash FULLY
    // denied (no curl/wget — the auditor has no network need). envsitter keys
    // enumerate the envsitter-guard plugin's actual tool names (the brief's
    // envsitter_read/envsitter_edit map to these individual names).
    "ai-auditor": {
      "description": "Independent read-only reviewer for §10 config changes. Pure-analyst tier — findings routed via orchestrator for persistence.",
      "mode": "subagent",
      "color": "#10B981",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "apply_patch": "deny",
        "ast_grep_replace": "deny",
        "webfetch": "deny",
        "task": "deny",
        "envsitter_set": "deny",
        "envsitter_add": "deny",
        "envsitter_delete": "deny",
        "envsitter_unset": "deny",
        "envsitter_annotate": "deny",
        "envsitter_format": "deny",
        "envsitter_reorder": "deny",
        "envsitter_copy": "deny",
        "envsitter_keys": "deny",
        "envsitter_scan": "deny",
        "envsitter_match": "deny",
        "envsitter_match_by_key": "deny",
        "envsitter_fingerprint": "deny",
        "envsitter_validate": "deny",
        "envsitter_help": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow"
      }
    }
  },

  // ---------------------------------------------------------------------------
  // Provider Definitions — models available for all agents
  // ---------------------------------------------------------------------------
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen2.5-coder:14b": {
          "name": "Qwen 2.5 Coder 14B (FAST)",
          "roles": [
            "chat",
            "edit",
            "apply"
          ]
        },
        "qwen3-coder:30b": {
          "name": "Qwen 3 Coder 30B (Heavy reasoning)",
          "roles": [
            "chat",
            "edit",
            "apply"
          ]
        },
        "gemma3:12b": {
          "name": "Gemma 3 12B (Lightweight — RAG / theory)",
          "roles": [
            "chat",
            "edit",
            "apply"
          ]
        }
      }
    }
  },

  // ---------------------------------------------------------------------------
  // References — Memory Shelf location
  // ---------------------------------------------------------------------------
  "references": {
    "shelf": {
      "path": ".opencode/memory-shelf.yaml",
      "description": "Memory Shelf, agent config, and opencode project settings. Read .opencode/memory-shelf.yaml first — it's the central index of all RAG knowledge bases, research conspects, specs, and analyses."
    }
  },

  // ---------------------------------------------------------------------------
  // Plugins — loaded by OpenCode for this project
  // ---------------------------------------------------------------------------
  "plugin": [
    "envsitter-guard@0.0.4",
    "@tarquinen/opencode-dcp@3.1.14",
    "oh-my-opencode-slim@2.2.8",
    "file://./.opencode/plugins/delegation-observer.ts"
  ],

  // ---------------------------------------------------------------------------
  // Skills — dynamic loading from remote sources
  // ---------------------------------------------------------------------------
  // Skills in .opencode/skills/ are always loaded locally.
  // skills.urls allows pulling additional skills from GitHub or other URLs at startup.
  // Format: URL to a tar.gz archive containing SKILL.md directories.
  // Example: "https://github.com/org/poetry-skills/archive/main.tar.gz#path=skills/"
  // Currently empty — enable by publishing custom skills to a remote archive.
  "skills": {
    "urls": []
  },

  // ---------------------------------------------------------------------------
  // MCP Servers — live external tool access
  // ---------------------------------------------------------------------------
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "oauth": false,
      "timeout": 15000,
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      },
      "enabled": true,
      "description": "Search library documentation (Node.js, Python, NumPy, etc.)"
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "description": "Search GitHub for reference code patterns"
    }
  },


  // ---------------------------------------------------------------------------
  // Custom Commands — reusable multi-step workflows via Ctrl+K
  // ---------------------------------------------------------------------------
  "command": {
    "tdd-cycle": {
      "template": "Execute a full TDD cycle for $ARGUMENTS:\n1. If a spec is not yet captured, dispatch @openspec-plan for interview-first spec authoring (Socratic interview → artifact synthesis → openspec validate). Do NOT invoke the openspec-propose skill directly.\n2. For each task (a vertical slice): RED — write a failing test at a pre-agreed seam (invoke tdd-craftsman)\n3. GREEN — implement the minimum code to pass that one test, one slice at a time\n4. Run verification gates after each task: turbo run typecheck lint test --filter=<affected package>\n5. When all slices are green, dispatch @reviewer for the two-axis review (Standards + Spec)",
      "description": "Full feature TDD cycle — spec → vertical-slice test-first implementation → two-axis review (e.g. /tdd-cycle implement stress detection for Ukrainian)",
      "agent": "coder"
    },
    "test-package": {
      "template": "Run the test suite for @poetry/$ARGUMENTS with turbo run test --filter=@poetry/$ARGUMENTS. If any tests fail, analyze the errors and suggest fixes.",
      "description": "Run tests for a specific package (e.g. /test-package editor-engine)",
      "agent": "coder"
    },
    "arch-check": {
      "template": "Review the architecture of the code at $ARGUMENTS against architecture.md and SOLID principles. Check for: single responsibility violations, missing DI, state mutation outside Orchestrator, worker boundary leaks, OCC version check omissions. Report any violations with specific line references.",
      "description": "Audit code against architectural standards (e.g. /arch-check packages/editor-engine/src)",
      "agent": "architector"
    },
    "code-ownership": {
      "template": "Analyze the code at $ARGUMENTS for maintainability and ownership:\n1. Are public APIs documented with JSDoc explaining WHY?\n2. Are modules single-responsibility?\n3. Is there dead code or speculative generality?\n4. Are tests present and meaningful?\n5. Are there architectural pattern violations?\nProduce a maintainability score (1-10) and specific improvement recommendations.",
      "description": "Evaluate code ownership quality and maintainability (e.g. /code-ownership packages/phonetics-core)",
      "agent": "architector"
    }
  }
}
