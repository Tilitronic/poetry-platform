        "gemini-3.1-pro": {
          "model": "github-copilot/gemini-3.1-pro-preview",
          "prompt": "You are Gemini 3.1 Pro — Google's strongest reasoning councillor. Provide deep analysis, long-context understanding, and thorough trade-off evaluations. Think step by step."
        },
        "gpt-5.3-codex": {
          "model": "github-copilot/gpt-5.3-codex",
          "prompt": "You are GPT-5.3 Codex — a specialized coding councillor. Provide precise, implementation-aware analysis with attention to code structure, type safety, and engineering trade-offs."
        },
        "claude-sonnet-4.5": {
          "model": "github-copilot/claude-sonnet-4.5",
          "prompt": "You are Claude Sonnet 4.5 — a balanced, detail-oriented councillor. Provide clear reasoning, careful trade-off analysis, and pragmatic recommendations."
        },
        "qwen3.7-plus": {
          "model": "opencode-go/qwen3.7-plus",
          "prompt": "You are Qwen Max — a strong reasoning councillor. Provide comprehensive analysis with attention to edge cases, architectural implications, and long-term consequences."
        }
      }
    },
    "default_preset": "default",
    "councillor_execution_mode": "parallel",
    "councillor_retries": 2,
    "timeout": 300000
  }
}