{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "plugin": [
    "file:///workspace/.opencode/oh-my-opencode-slim"
  ],
  "agent": {
    "boss": {
      "mode": "all",
      "color": "#6366F1"
    },
    "architector": {
      "mode": "all",
      "color": "#8B5CF6",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "reviewer": {
      "mode": "all",
      "color": "#F59E0B",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "coder": {
      "mode": "subagent",
      "color": "#3B82F6"
    },
    "code-navigator": {
      "mode": "subagent",
      "color": "#06B6D4"
    },
    "researcher": {
      "mode": "subagent",
      "color": "#84CC16"
    },
    "designer": {
      "mode": "subagent",
      "color": "#EC4899"
    },
    "observer": {
      "mode": "subagent",
      "color": "#A855F7"
    }
  }
}
