# MCP server key (context7 library docs search)
CONTEXT7_API_KEY=

# === Postgres (stateful service container) ===
POSTGRES_USER=poetry
POSTGRES_PASSWORD=poetry
POSTGRES_DB=poetry
# POSTGRES_PORT=5432   # uncomment to expose postgres to the host

# === App service ports (host-side mapping) ===
AUTHOR_STUDIO_PORT=9000
API_SERVER_PORT=8000
PUBLISHING_PORT=3000

# === Container UID/GID alignment (DIA-260821-m7vk) ===
# Align the dev container's `dev` user UID/GID with the HOST user so the
# bind-mounted .git/ (and named volumes) are writable from inside the container.
# If your host UID/GID != 1000, the pre-commit lint-staged hook fails with
# "could not write index" (EACCES). Run `id -u` / `id -g` on the host and set
# these, then `make clean && make up` to rebuild the image. Default 1000 keeps
# the old behavior for hosts already on 1000.
USER_UID=1000
USER_GID=1000

# === Datetime of compose config ===
# (intentionally empty — DATABASE_URL is assembled in docker-compose.yml)
