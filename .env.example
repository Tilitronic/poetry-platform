# MCP server key (context7 library docs search)
CONTEXT7_API_KEY=

# === Postgres (stateful service container) ===
POSTGRES_USER=poetry
POSTGRES_PASSWORD=poetry
POSTGRES_DB=poetry
# POSTGRES_PORT=5432   # uncomment to expose postgres to the host

# === App service ports (host-side mapping) ===
AUTHOR_STUDIO_PORT=9000
API_SERVER_PORT=8000
PUBLISHING_PORT=3000

# === Datetime of compose config ===
