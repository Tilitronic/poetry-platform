#!/usr/bin/env bash
# opencode-dev — unified Docker dev-runtime launcher (DIA-260821-x5nj).
# Engine (podman|docker) + OS (wsl|native) selection via --engine/--os
# overrides or auto-detection. Bash-3 compatible (ADR 8).
set -euo pipefail

engine=""
os=""
mode="bash"

while [ $# -gt 0 ]; do
  case "$1" in
    --engine=podman)  engine="podman" ;;
    --engine=docker)  engine="docker" ;;
    --os=wsl)         os="wsl" ;;
    --os=native)      os="native" ;;
    --run-opencode)   mode="opencode" ;;
    --test)           mode="test" ;;
    *) echo "opencode-dev: unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

# Auto-detect engine: Podman if the version output reports Podman, else Docker.
# Uses `docker version` (not `--version`) because the launcher's mock answers
# the bare `version` subcommand; Podman's version output still contains
# "Podman", so the detection intent is unchanged.
if [ -z "$engine" ]; then
  ver="$(docker version 2>/dev/null || true)"
  case "$ver" in
    *Podman*) engine="podman" ;;
    *)        engine="docker" ;;
  esac
fi

# Auto-detect OS: WSL if /proc/version mentions Microsoft/WSL, else native.
if [ -z "$os" ]; then
  if grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null; then
    os="wsl"
  else
    os="native"
  fi
fi

case "$engine" in
  podman) engine_file="docker-compose.podman.yml" ;;
  docker) engine_file="docker-compose.rootless-docker.yml" ;;
esac
os_file=""
if [ "$os" = "wsl" ]; then
  os_file="docker-compose.wsl.yml"
fi

# Apply the override set via COMPOSE_FILE so `up`/`exec` stay free of -f flags
# (the launcher contract records clean `compose up -d dev` / `compose exec dev
# ...` lines). ponytail: env-var override, not a wrapper script.
compose_list="docker-compose.yml:${engine_file}"
if [ -n "$os_file" ]; then
  compose_list="${compose_list}:${os_file}"
fi
export COMPOSE_FILE="$compose_list"

# Secrets ownership preflight (T7.0b, design.md Seam 5): refuse to start the
# container unless ./secrets/ is owned by the invoking user with every secret
# file mode 0600. The check prints actionable chown/chmod diagnostics itself
# and never remediates; set -e aborts here on its non-zero exit. The helper is
# resolved relative to THIS script so a non-repo-root CWD yields a real
# ownership verdict instead of command-not-found; ./secrets itself stays
# CWD-relative like the compose files.
launcher_dir="$(dirname "${BASH_SOURCE[0]}")"
"$launcher_dir/check-secrets-ownership.sh"

# Pre-flight: validate the merged override set. Also records the selected
# override files for the launcher contract tests (the mock records every call).
config_flags="-f docker-compose.yml -f $engine_file"
if [ -n "$os_file" ]; then
  config_flags="$config_flags -f $os_file"
fi
docker compose $config_flags config >/dev/null

docker compose up -d dev

# Self-healing launch (DIA-260824-a3mk): opencode routes through the
# entrypoint as root so the entrypoint repairs any root-owned log, then drops to
# dev via gosu. Other modes run as dev directly (never as root).
case "$mode" in
  opencode)
    docker compose exec -it --user root dev /usr/local/bin/dev-entrypoint.sh opencode
    ;;
  test)
    docker compose exec -T --user dev dev make test-infra
    ;;
  *)
    docker compose exec -it --user dev dev bash
    ;;
esac
