#!/usr/bin/env python3
# scripts/promo-preset-apply - clone the active OMO preset into a "promo"
# preset with ana036 promo routing, preserving JSONC comments (DIA-260828-qtsi).
#
# Design (ponytail): no JSONC lib is installed, so we (1) parse the whole file
# comment-stripped to get the dict for transformation, and (2) do a TEXT-level
# insert/replace of the "promo" block so every other preset's // comments stay
# intact. The promo block is generated, not hand-edited, so re-running is a
# no-op (idempotent) and always reflects the current active preset + routing.
#
# Usage:
#   scripts/promo-preset-apply [--dry-run] [--config PATH] [--registry PATH]
#   scripts/promo-preset-apply --help
#
# Does NOT change the active preset pointer (active stays as-is).

import argparse
import copy
import json
import os
import sys

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
REPO_ROOT = os.path.dirname(SCRIPT_DIR)
CONFIG_DEFAULT = os.path.join(REPO_ROOT, ".opencode", "oh-my-opencode-slim.jsonc")
REGISTRY_DEFAULT = os.path.join(REPO_ROOT, ".opencode", "promo-registry.json")

# ana036 section 8.2 promo routing. Lanes not listed are cloned unchanged.
# Format mirrors promo preset: object {"id","variant"} where a variant is forced,
# else plain string. Fallback order matters (primary first).
ROUTING = {
    # DIA-260828-qtsi: Muse Spark admitted as primary for the 6 lanes below,
    # DeepSeek V4 Flash as fallback for burst (100 RPM cap). Other lanes cloned unchanged.
    "coder": ["opencode-go/muse-spark-1.2-contributor", "opencode-go/deepseek-v4-flash"],
    "reviewer": ["opencode-go/muse-spark-1.2-contributor", "opencode-go/deepseek-v4-flash"],
    "analyzer": ["opencode-go/muse-spark-1.2-contributor", "opencode-go/deepseek-v4-flash"],
    "researcher": ["opencode-go/muse-spark-1.2-contributor", "opencode-go/deepseek-v4-flash"],
    "conspecter": ["opencode-go/muse-spark-1.2-contributor", "opencode-go/deepseek-v4-flash"],
    "openspec-plan": ["opencode-go/muse-spark-1.2-contributor", "opencode-go/deepseek-v4-flash"],
    "orchestrator": ["opencode-go/deepseek-v4-flash", "opencode-go/mimo-v2.5-free"],
    "resource-manager": ["opencode/mimo-v2.5-free", "opencode-go/deepseek-v4-flash"],
    "memory-manager": ["opencode/mimo-v2.5-free", "opencode-go/deepseek-v4-flash"],
    "code-navigator": ["opencode/mimo-v2.5-free", "opencode-go/deepseek-v4-flash"],
}


def strip_jsonc_comments(text):
    """Remove // and /* */ comments outside string literals. Minimal scanner."""
    out = []
    i = 0
    n = len(text)
    in_str = False
    q = ""
    while i < n:
        c = text[i]
        if in_str:
            out.append(c)
            if c == "\\" and i + 1 < n:
                out.append(text[i + 1])
                i += 2
                continue
            if c == q:
                in_str = False
            i += 1
            continue
        if c in ('"', "'"):
            in_str = True
            q = c
            out.append(c)
            i += 1
            continue
        if c == "/" and i + 1 < n and text[i + 1] == "/":
            while i < n and text[i] != "\n":
                i += 1
            continue
        if c == "/" and i + 1 < n and text[i + 1] == "*":
            i += 2
            while i + 1 < n and not (text[i] == "*" and text[i + 1] == "/"):
                i += 1
            i += 2
            continue
        out.append(c)
        i += 1
    return "".join(out)


def find_preset_block(text, key):
    """Return (start, end_exclusive) span of `    "key": { ... }` at preset indent."""
    marker = '    "%s": {' % key
    idx = text.find(marker)
    if idx == -1:
        return None
    brace_open = idx + len(marker) - 1  # position of the '{'
    depth = 0
    i = brace_open
    while i < len(text):
        ch = text[i]
        if ch == "{":
            depth += 1
        elif ch == "}":
            depth -= 1
            if depth == 0:
                return (idx, i + 1)
        i += 1
    return None


def find_promo_region(text):
    """Return (start, end_exclusive) span of the promo block INCLUDING its
    preceding auto-generated header comment block.

    The promo block is fully regenerated by this script, so its header comment
    is part of the region we own. Extending start backward over the header makes
    re-runs replace the whole region (idempotent) instead of stacking a new
    header above the old one on every 2-week review (B1, DIA-260828-qtsi)."""
    block = find_preset_block(text, "promo")
    if not block:
        return None
    start, end = block
    # Start at the beginning of the line that holds `    "promo": {`, then walk
    # upward one line at a time while the line above is a // comment.
    line_start = text.rfind("\n", 0, start) + 1
    i = line_start
    header_spans = []
    while i > 0:
        nl = text.rfind("\n", 0, i)          # newline ending the line above i
        if nl == -1:
            break
        nl_prev = text.rfind("\n", 0, nl)    # newline before that
        above_start = nl_prev + 1 if nl_prev != -1 else 0
        above_line = text[above_start:nl]
        if above_line.lstrip().startswith("//"):
            i = above_start
            header_spans.append((above_start, nl))
        else:
            break
    # Only treat as our header if it carries the auto-generated marker; an
    # unrelated comment sitting above the block is left untouched.
    marker = "auto-generated by scripts/promo-preset-apply"
    if any(marker in text[hs:he] for hs, he in header_spans):
        start = i
    return (start, end)


def main():
    ap = argparse.ArgumentParser(
        description="Clone active OMO preset into a 'promo' preset with ana036 routing (comments preserved).")
    ap.add_argument("--dry-run", action="store_true", help="print the block and validate, do not write")
    ap.add_argument("--config", default=CONFIG_DEFAULT, help="path to oh-my-opencode-slim.jsonc")
    ap.add_argument("--registry", default=REGISTRY_DEFAULT, help="path to promo-registry.json")
    args = ap.parse_args()

    with open(args.config, encoding="utf-8") as f:
        raw = f.read()

    # Parse comment-stripped copy to get the dict for transformation.
    parsed = json.loads(strip_jsonc_comments(raw))
    presets = parsed.get("presets", {})
    active = parsed.get("preset")
    if active not in presets:
        print("error: active preset %r not found in presets block" % active, file=sys.stderr)
        return 2
    if args.dry_run:
        print("info: active preset = %s" % active)

    promo = copy.deepcopy(presets[active])
    for lane, model in ROUTING.items():
        if lane in promo:
            promo[lane]["model"] = model
        elif args.dry_run:
            print("warn: lane %s not in active preset, skipped" % lane)

    # Build the promo block text (4-space indent under "presets": {).
    serialized = json.dumps(promo, indent=2)
    lines = serialized.split("\n")
    block_lines = ['    "promo": {']
    for ln in lines[1:]:
        block_lines.append("    " + ln)
    block = "\n".join(block_lines) + ",\n"

    # Header comment (ASCII-only). Pull review dates from the registry if present.
    last_reviewed = "2026-08-28"
    next_review = "2026-09-11"
    try:
        with open(args.registry, encoding="utf-8") as f:
            reg = json.load(f)
        last_reviewed = reg.get("last_reviewed", last_reviewed)
        next_review = reg.get("next_review", next_review)
    except FileNotFoundError:
        pass

    header = (
        "    // 2026-08-28 DIA-260828-qtsi: PROMO PRESET (auto-generated by scripts/promo-preset-apply).\n"
        "    // Clone of active %s with ana036 promo routing; Muse Spark ADMITTED primary (DIA-260828-qtsi,\n"
        "    // privacy cleared by developer) for coder/reviewer/analyzer/researcher/conspecter/openspec-plan, DeepSeek V4 Flash fallback.\n"
        "    // Review cadence 2 weeks; next review %s.\n"
        "    // NOT active (active preset stays %s). Re-run script to regenerate.\n"
    ) % (active, next_review, active)
    block = header + block

    # Insert or replace in the raw text (comment-preserving). find_promo_region
    # includes the preceding header so re-runs stay idempotent (B1).
    existing = find_promo_region(raw)
    if existing:
        start, end = existing
        j = end
        if j < len(raw) and raw[j] == ",":
            j += 1
        # Skip only the newline(s) between the promo block and the next preset;
        # do NOT consume the next preset's indentation spaces (B2, DIA-260828-qtsi).
        while j < len(raw) and raw[j] in "\n\r":
            j += 1
        new_text = raw[:start] + block + raw[j:]
        action = "replaced"
    else:
        free = find_preset_block(raw, "free")
        if not free:
            print("error: 'free' preset anchor not found; cannot insert promo", file=sys.stderr)
            return 2
        new_text = raw[:free[0]] + block + raw[free[0]:]
        action = "inserted"

    # Validate the result parses as JSONC before writing.
    try:
        json.loads(strip_jsonc_comments(new_text))
    except json.JSONDecodeError as e:
        print("error: generated config is invalid JSON: %s" % e, file=sys.stderr)
        return 1

    if args.dry_run:
        print("info: would %s 'promo' preset (valid JSON). Block:\n" % action)
        print(block)
        return 0

    with open(args.config, "w", encoding="utf-8") as f:
        f.write(new_text)
    print("ok: %s 'promo' preset in %s (active preset unchanged: %s)" % (action, args.config, active))
    return 0


if __name__ == "__main__":
    sys.exit(main())
