#!/usr/bin/env bash
# changelog-render — derive .opencode/CHANGELOG.md from .opencode/CHANGELOG.yaml.
#
# WHY this script exists (DIA-194 Variant B): .opencode/CHANGELOG.yaml is the
# machine-first source of truth for the changelog ledger (token economy:
# per-DIA yq selects instead of full-file reads, ana024 §2); .opencode/
# CHANGELOG.md is the derived human-readable view, regenerated by this script
# and committed alongside the ledger (ADR: Derived MD View Committed, DIA-194
# §10 — keeps human-readable PR diffs while the YAML stays queryable).
#
# Stack note (deliberate deviation from the DIA-194 §2 design wording "bash +
# yq"): yq is NOT part of the settled toolchain — DIA-137 rejected it
# (knowledge/res027 §2.7: "zero-runtime-dep is a feature; jq suffices") and it
# is not installed on host or dev container. The repo's settled YAML stack is
# PyYAML via embedded python3 (validate-memory-shelf.sh, validate-skills.sh),
# so this script mirrors that pattern: a bash wrapper around a python3
# heredoc. jq cannot parse YAML block scalars, which is why the render logic
# lives in python rather than jq.
#
# Layout (DIA-194 §2, verbatim):
#   ## <date> - <ticket> (<status>): <scope>
#   - **Change:** <summary>
#   - **Files:** <files array joined by " - ">
#   - **Verification:** <verification>
#
# Defensive behavior: missing/unreadable YAML, YAML that parses to None
# (empty file), entries missing required keys, and entries whose required
# fields are not strings all exit nonzero — a broken ledger must never
# silently produce a broken derived view. An explicit `[]` ledger renders the
# title block only (valid empty ledger, exit 0).
#
# Env overrides (bats hermetic seam, mirrors validate-changelog.sh):
#   CHANGELOG_YAML  input ledger (default .opencode/CHANGELOG.yaml)
#   CHANGELOG_MD    output view  (default .opencode/CHANGELOG.md)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CHANGELOG_YAML="${CHANGELOG_YAML:-$SCRIPT_DIR/../.opencode/CHANGELOG.yaml}"
CHANGELOG_MD="${CHANGELOG_MD:-$SCRIPT_DIR/../.opencode/CHANGELOG.md}"

if ! command -v python3 >/dev/null 2>&1; then
  echo "error: python3 is required to render .opencode/CHANGELOG.md (PyYAML stack, same requirement as validate-memory-shelf.sh)." >&2
  exit 2
fi
if [ ! -f "${CHANGELOG_YAML}" ]; then
  echo "error: CHANGELOG.yaml not found at ${CHANGELOG_YAML} (override with CHANGELOG_YAML)." >&2
  exit 2
fi

python3 - "${CHANGELOG_YAML}" "${CHANGELOG_MD}" <<'PYEOF'
import sys

import yaml

yaml_path, md_path = sys.argv[1], sys.argv[2]

try:
    with open(yaml_path) as f:
        entries = yaml.safe_load(f)
except Exception as exc:  # yaml.ScannerError, IOError, ...
    print("FAIL: YAML parse error in %s: %s" % (yaml_path, " ".join(str(exc).split())))
    sys.exit(1)

if entries is None:
    # Empty file: yaml.safe_load returns None. A real ledger must carry
    # entries; an empty file is a structural failure (defensive, DIA-194 §2),
    # unlike an explicit `[]` which renders the empty view below.
    print("FAIL: %s is empty (parses to None); a changelog ledger must have entries." % yaml_path)
    sys.exit(1)

REQUIRED = ("date", "ticket", "scope", "files", "summary", "verification")

lines = ["# OpenCode Config Changelog", ""]
if not entries:
    # Explicit empty ledger: title block only, no entries.
    lines.append("(no changelog entries)")
else:
    for idx, entry in enumerate(entries):
        where = "changelog[%d]" % idx
        if not isinstance(entry, dict):
            print("FAIL: %s is not a mapping" % where)
            sys.exit(1)
        for key in REQUIRED:
            if not isinstance(entry.get(key), str) and key != "files":
                print("FAIL: %s missing required '%s' (or not a string)" % (where, key))
                sys.exit(1)
            if key == "files" and not isinstance(entry.get(key), list):
                print("FAIL: %s missing required 'files' (or not a list)" % where)
                sys.exit(1)

        date = entry["date"]
        ticket = entry["ticket"]
        scope = entry["scope"]
        status = entry.get("status")

        header = "## %s - %s" % (date, ticket)
        if status:
            header += " (%s)" % status
        header += ": %s" % scope
        lines.append(header)
        lines.append("")
        lines.append("- **Change:** %s" % entry["summary"])
        lines.append("- **Files:** %s" % " - ".join(entry["files"]))
        lines.append("- **Verification:** %s" % entry["verification"])
        lines.append("")

# Strip the trailing blank line, write the derived view.
with open(md_path, "w") as f:
    f.write("\n".join(lines).rstrip("\n") + "\n")

print("ok: wrote %s (%d entries)" % (md_path, len(entries)))
PYEOF
