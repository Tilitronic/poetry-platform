#!/usr/bin/env bash
# allocate-id - unified ID generator for all artifact types.
#
# WHY: different artifact types used different ID patterns (DIA-NNN,
# resNNN, anaNNN, tchNNN), creating collision risks under concurrent
# sessions. This script centralises allocation with a single format:
# <type>-YYMMDD-<random4>-<slug> (DIA-260819-8kwm).
#
# Usage: allocate-id <type> <slug>
# Example: allocate-id res ticket-navigation
#
# Exit codes: 0 success; 1 usage/type error.

set -euo pipefail

TYPE="${1:-}"
SLUG="${2:-}"

if [[ -z "$TYPE" || -z "$SLUG" ]]; then
  echo "Usage: allocate-id <type> <slug>" >&2
  echo "Types: res, ana, tch, DIA" >&2
  exit 1
fi

# Validate type
case "$TYPE" in
  res|ana|tch|DIA) ;;
  *) echo "Error: invalid type '$TYPE'. Must be: res, ana, tch, DIA" >&2; exit 1 ;;
esac

# Generate datetime component (YYMMDD)
DATE=$(date +%y%m%d)

# Generate random 4-char suffix (alphanumeric lowercase).
# 64 bytes gives ~9 alphanumeric chars on average (36/256 per byte);
# || true swallows SIGPIPE from head -c4 closing the pipe early under pipefail.
RAND=$(head -c64 /dev/urandom | tr -dc 'a-z0-9' | head -c4 || true)

# Output: <type>-YYMMDD-<random4>-<slug>
echo "${TYPE}-${DATE}-${RAND}-${SLUG}"
