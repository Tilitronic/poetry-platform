{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate:phonetic-atlas": {
      "inputs": [
        "src/atlas/phonetic_atlas.fbs",
        "scripts/generate_phonetic_atlas.py",
        "scripts/generated/**"
      ],
      "outputs": ["src/atlas/phonetic_atlas.bin", "dist/phonetic_atlas.bin"]
    },
    "codegen": {
      "dependsOn": ["generate:phonetic-atlas"],
      "inputs": ["src/atlas/phonetic_atlas.fbs"],
      "outputs": ["dist/ts/**", "dist/python/**", "dist/rust/**", "dist/cpp/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".quasar/**", "dist/spa/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["src/**"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "format": {
      "cache": false
    },
    // Per-package test-task overrides (DIA-125): the base `test` task keeps
    // dependsOn:["build"] for any package whose tests consume build output.
    // The four packages below were verified (2026-08-12) to run their full
    // vitest suite standalone with no build artifacts — their tests import
    // sources/deps only (no dist/). Keep a package's entry here ONLY after
    // proving its tests pass with `pnpm --filter <pkg> exec vitest run`.
    "@poetry/editor-engine#test": {
      "dependsOn": []
    },
    "@poetry/data-contracts#test": {
      "dependsOn": []
    },
    "@poetry/phonetics-core#test": {
      "dependsOn": []
    },
    "author-studio#test": {
      "dependsOn": []
    }
  }
}
