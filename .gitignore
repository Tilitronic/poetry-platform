scripts/__tests__/vendor/

# === OpenCode Docker tool ===
tools/opencode-docker/workspace/
tools/opencode-docker/homebase/
tools/opencode-docker/secrets/
tools/opencode-docker/.worktrees/
tools/opencode-docker/worktrees/
tools/opencode-docker/opencode.json
tools/opencode-docker/.opencode/
tools/opencode-docker/.cache/opencode/

# === Dev container ===
# Secrets catch-all (M7): every file in secrets/ is ignored so future-named
# key files are never accidentally committed; only README.md is allowed.
secrets/*
!secrets/README.md

# Orchestrator session state (transient, regenerated per session)
.opencode/session/

# === OpenCode clipboard/screenshot artifacts (transient) ===
.opencode/images/

# DIA-135 scratch dir (coders never need /tmp)
.scratch/
