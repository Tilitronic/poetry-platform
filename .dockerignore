# === VCS ===
.git/
.gitignore

# === Dependencies ===
node_modules/
**/node_modules/
.pnpm-store/
**/.pnpm-store/

# === Build outputs ===
dist/
**/dist/
.output/
**/.output/
.next/
**/.next/
.astro/
**/.astro/
.nuxt/
**/.nuxt/
.quasar/
**/.quasar/
*.tsbuildinfo
**/*.tsbuildinfo

# === Turbo ===
.turbo/
**/.turbo/

# === Python ===
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
**/.pytest_cache/
*.egg-info/
.venv/
**/.venv/

# === Environment / secrets (never bake into image) ===
.env
.env.*
.env.example
secrets/
**/secrets/

# === Logs ===
*.log

# === Docs (keep image lean) ===
docs/
knowledge/
*.md
