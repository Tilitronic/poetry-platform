{
  "name": "poetry-platform-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "stack": "bash scripts/dev-stack.sh",
    "format": "prettier --write \"**/*.{js,ts,vue,css,scss,html,md,json}\"",
    "format:check": "prettier --check \"**/*.{js,ts,vue,css,scss,html,md,json}\"",
    "test": "turbo test --filter=!author-studio",
    "verify:format": "pnpm format:check",
    "verify:js": "pnpm lint && pnpm typecheck",
    "verify:js-tests": "pnpm test",
    "verify:python": "bash scripts/verify-python.sh",
    "verify": "pnpm verify:format && pnpm verify:js && pnpm verify:js-tests && pnpm verify:python",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@quasar/app-vite": "^2.5.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.0.0",
    "prettier": "^3.8.1",
    "turbo": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,html,md,json,yaml,yml}": [
      "prettier --write"
    ],
    "apps/api-server/**/*.py": [
      "scripts/lint-python-files.sh"
    ],
    "packages/analytics-pipeline/**/*.py": [
      "scripts/lint-python-files.sh"
    ],
    "*.sh": [
      "bash -n"
    ]
  },
  "packageManager": "pnpm@10.33.0",
  "overrides": {
    "@eslint/eslintrc": "3.3.6",
    "body-parser": "1.20.6",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9",
    "esbuild": ">=0.28.1",
    "immutable": "5.1.9",
    "postcss": "8.5.25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
